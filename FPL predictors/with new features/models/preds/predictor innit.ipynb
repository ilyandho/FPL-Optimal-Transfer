    "# Utils\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 154,
   "id": "183a11dc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def calc_xP_pred(row):\n",
    "    # Minutes played bonus\n",
    "    if row['minutes_3'] >= 60:\n",
    "        minutes_bonus = 2\n",
    "    elif row['minutes_3'] > 0:\n",
    "        minutes_bonus = 1\n",
    "    else:\n",
    "        minutes_bonus = 0  # if player didn't play at all\n",
    "    if row['position'] == '1':\n",
    "\n",
    "        ## GK\n",
    "        ## ---> >60  = 2\n",
    "        ## ---> cs*4\n",
    "        ## ---> ((sv)/3)*1\n",
    "        ## ---> (gc/2)*-1\n",
    "        ## ---> yc*-1\n",
    "        return (\n",
    "            minutes_bonus +\n",
    "            4 * row['cs_preds'] +\n",
    "            1 * round(row['saves_preds']/3, 3) -\n",
    "            1 * round(row['xgc_preds']/2, 3) -\n",
    "            1 * row['y_preds']\n",
    "        )\n",
    "\n",
    "    elif row['position'] == '2':\n",
    "        ## DEF\n",
    "        ## ---> >60  = 2\n",
    "        ## ---> xg*6\n",
    "        ## ---> xa*3\n",
    "        ## ---> cs*4\n",
    "        ## ---> gc\n",
    "        ## ---> yc*-1\n",
    "\n",
    "\n",
    "        return (\n",
    "            minutes_bonus +\n",
    "            6 * row['xg_preds'] +\n",
    "            3 * row['xa_preds'] +\n",
    "            4 * row['cs_preds'] -\n",
    "            1 * round(row['xgc_preds']/2, 3) -\n",
    "            1 * row['y_preds']\n",
    "        )\n",
    "    elif row['position'] == '3':\n",
    "        ## MID\n",
    "        ## ---> >60  = +2\n",
    "        ## ---> xg*5\n",
    "        ## ---> xa*3\n",
    "        ## ---> cs*1\n",
    "        ## ---> yc*-1\n",
    "\n",
    "        return (\n",
    "            minutes_bonus +\n",
    "            5 * row['xg_preds'] +\n",
    "            3 * row['xa_preds'] +\n",
    "            1 * row['cs_preds'] -\n",
    "            1 * row['y_preds']\n",
    "        )\n",
    "    elif row['position'] == '4':\n",
    "        ## FWD\n",
    "        ## ---> >60  = 2\n",
    "        ## ---> xg*4\n",
    "        ## ---> xa*3\n",
    "        ## ---> yc*-1\n",
    "        # print(row['fpl_name'], row['position'], minutes_bonus +\n",
    "        #     4 * row['xg_preds'] +\n",
    "        #     3 * row['xa_preds'] -\n",
    "        #     1 * row['y_preds'])\n",
    "        return (\n",
    "            minutes_bonus +\n",
    "            4 * row['xg_preds'] +\n",
    "            3 * row['xa_preds'] -\n",
    "            1 * row['y_preds']\n",
    "        )\n",
    "    else:\n",
    "        return 0  # fallback for unknown positions\n"
   ]
